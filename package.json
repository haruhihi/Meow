    "sync:stock-indices": "node scripts/sync-stock-index-snapshots.mjs",
    "refresh:stock-metric-cache": "node scripts/refresh-stock-metric-cache.mjs",
    "prepare:stock-ai-report-evidence": "node scripts/prepare-stock-ai-report-evidence.mjs",
    "migrate:categories": "node scripts/archive/migrate-categories.mjs",
    "migrate:categories:apply": "node scripts/archive/migrate-categories.mjs --apply",
    "migrate:leisure-categories": "node scripts/migrate-leisure-categories.mjs",
