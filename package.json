    "antd-mobile": "^5.38.1",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "eruda": "^3.4.1",
    "jose": "^5.9.6",
    "lodash-es": "^4.17.21",
    "mobx": "^6.15.4",
    "mobx-react-lite": "^4.1.1",
    "next": "^14.2.22",
