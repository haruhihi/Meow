// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  account   String   @unique
  nickname  String // User's nickname
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Transaction Transaction[] @relation
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String // Category name
  parentId Int? // Parent category ID
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent") // Children categories

  Transaction Transaction[] @relation
}

model Transaction {
  id             Int      @id @default(autoincrement())
  userId         Int // User ID
  categoryId     Int // Category of the transaction (mandatory)
  couponId       Int?
  couponName     String?  @db.VarChar(255)
  couponDiscount Float    @default(0)
  amount         Float // Transaction amount before coupon discount
  description    String?  @db.VarChar(255) // Optional description
  date           DateTime // Transaction date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  coupon   Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
}

model Coupon {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  type            String?  @db.VarChar(80)
  amount          Float
  remainingAmount Float
  validYear       Int
  validMonth      Int
  startDate       DateTime
  endDate         DateTime
  seedKey         String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions Transaction[]

  @@index([validYear, validMonth])
  @@index([name])
}

model AI_Tool {
  id           String   @id @unique @default(uuid()) // UUID as primary key
  link         String
  name         String
  desc         String // description
  icon         String? // icon svg content
  category1    String
  category2    String?
  tags         String[]
  registration Boolean?
  free         Boolean? // Has free version?
  pro          Boolean? // Has pro version? null is unknown
  pro_price    String? // price of pro version: null(unknown) | Exact price (如 "9.99")
  score        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
