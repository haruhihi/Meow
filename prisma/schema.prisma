// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  account   String   @unique
  nickname  String // User's nickname
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Transaction  Transaction[]  @relation
  ActivityType ActivityType[] @relation
  TimeEntry    TimeEntry[]    @relation
  StockAccount StockAccount[] @relation
  StockHolding StockHolding[] @relation
  StockQuote   StockQuote[]   @relation
  StockCash    StockCash?     @relation
  StockMetricOverride StockMetricOverride[] @relation
  StockDividendMarking StockDividendMarking[] @relation
}

model StockDividendEvent {
  id                    Int      @id @default(autoincrement())
  eventKey              String   @unique @db.VarChar(160)
  symbol                String   @db.VarChar(32)
  announcementDate      DateTime?
  recordDate            DateTime?
  exDividendDate        DateTime?
  paymentDate           DateTime?
  cashPerTen            Float?
  bonusSharesPerTen     Float?
  transferSharesPerTen  Float?
  dividendBaseShares    Float?
  status                String?  @db.VarChar(80)
  description           String?  @db.VarChar(255)
  source                String   @db.VarChar(80)
  fetchedAt             DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  markings StockDividendMarking[] @relation

  @@index([symbol])
  @@index([announcementDate])
  @@index([exDividendDate])
}

model StockDividendMarking {
  id                            Int      @id @default(autoincrement())
  userId                        Int
  eventId                       Int
  countTowardNormalizedDividend Boolean  @default(false)
  note                          String?  @db.VarChar(255)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id])
  event StockDividendEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model StockFundamental {
  id                  Int      @id @default(autoincrement())
  symbol              String   @db.VarChar(32)
  reportDate          DateTime
  reportName          String?  @db.VarChar(80)
  totalShares         Float?
  deductedNetProfit   Float?
  deductedNetProfitTtm Float?
  netProfit           Float?
  netProfitTtm        Float?
  revenue             Float?
  revenueTtm          Float?
  netAsset            Float?
  totalAssets         Float?
  operatingCashFlow   Float?
  operatingCashFlowTtm Float?
  capitalExpenditure  Float?
  capitalExpenditureTtm Float?
  source              String   @db.VarChar(80)
  fetchedAt           DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([symbol, reportDate])
  @@index([symbol])
  @@index([reportDate])
}

model StockMetricOverride {
  id                 Int      @id @default(autoincrement())
  userId             Int
  symbol             String   @db.VarChar(32)
  normalizedDividend Float?
  note               String?  @db.VarChar(255)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, symbol])
  @@index([userId])
  @@index([symbol])
}

model StockCash {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  amount    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model StockAccount {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String   @db.VarChar(80)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id])
  holdings StockHolding[] @relation

  @@unique([userId, name])
  @@index([userId, sortOrder])
}

model StockHolding {
  id        Int      @id @default(autoincrement())
  userId    Int
  accountId Int
  symbol    String   @db.VarChar(32)
  quantity  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id])
  account StockAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([userId, accountId, symbol])
  @@index([userId])
  @@index([accountId])
  @@index([symbol])
}

model StockQuote {
  id           Int      @id @default(autoincrement())
  userId       Int
  symbol       String   @db.VarChar(32)
  name         String   @db.VarChar(120)
  currentPrice Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, symbol])
  @@index([userId])
  @@index([symbol])
}

model ActivityType {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String   @db.VarChar(80)
  color     String   @db.VarChar(16)
  icon      String?  @db.VarChar(80)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  timeEntries TimeEntry[] @relation

  @@unique([userId, name])
  @@index([userId, sortOrder])
}

model TimeEntry {
  id             Int      @id @default(autoincrement())
  userId         Int
  activityTypeId Int
  startedAt      DateTime
  endedAt        DateTime
  note           String?  @db.VarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  activityType ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)

  @@index([userId, startedAt])
  @@index([userId, endedAt])
  @@index([activityTypeId])
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String // Category name
  parentId Int? // Parent category ID
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent") // Children categories

  Transaction Transaction[] @relation
}

model Transaction {
  id             Int      @id @default(autoincrement())
  userId         Int // User ID
  categoryId     Int // Category of the transaction (mandatory)
  couponId       Int?
  couponName     String?  @db.VarChar(255)
  couponDiscount Float    @default(0)
  amount         Float // Transaction amount before coupon discount
  description    String?  @db.VarChar(255) // Optional description
  date           DateTime // Transaction date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  coupon   Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
}

model Coupon {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  type            String?  @db.VarChar(80)
  amount          Float
  remainingAmount Float
  validYear       Int
  validMonth      Int
  startDate       DateTime
  endDate         DateTime
  seedKey         String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions Transaction[]

  @@index([validYear, validMonth])
  @@index([name])
}
